# Copy this file to your home folder as  cloudflare-creative-mocks.env  (never into this repo) and fill it in
# from the "Creative Mocks" entry in Passbolt. One KEY=value per line, no quotes, no spaces around "=".
# Used by tools/port-to-r2.py (docs/HOSTING.md).

# the S3 API endpoint: https://<account id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=creative-mocks
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Only for updating an older playable that loads its game from campaign-creatives.iion.media (tools/upload-mock.py):
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
